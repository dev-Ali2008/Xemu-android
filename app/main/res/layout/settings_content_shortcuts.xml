        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:letterSpacing="0.12"
        android:text="MOVEMENT"
        android:textColor="@color/xanite_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="W / D-Pad Up"
          android:textColor="#FFF6EB"
          android:textSize="14sp" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Left Stick Up"
          android:textColor="#88FFFFFF"
          android:textSize="12sp" />
      </LinearLayout>

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/xanite_accent_1a" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="S / D-Pad Down"
          android:textColor="#FFF6EB"
          android:textSize="14sp" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Left Stick Down"
          android:textColor="#88FFFFFF"
          android:textSize="12sp" />
