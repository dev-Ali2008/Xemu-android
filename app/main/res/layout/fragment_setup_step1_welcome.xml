<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipToPadding="false"
  android:fillViewport="true"
  android:paddingHorizontal="24dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="24dp">

    <FrameLayout
      android:layout_width="112dp"
      android:layout_height="112dp">

      <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/setup_hub_logo"
        android:scaleX="1.65"
        android:scaleY="1.65"
        android:src="@drawable/xanite_gold_x" />
    </FrameLayout>

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:letterSpacing="0.06"
      android:text="@string/setup_title"
      android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
      android:textColor="@color/xaniteog_text"
      android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      app:cardBackgroundColor="@color/xaniteog_surface_variant"
      app:cardCornerRadius="12dp"
      app:cardElevation="4dp"
      app:strokeColor="@color/xaniteog_outline_variant"
      app:strokeWidth="1dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/setup_welcome_body"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/xaniteog_text_muted" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      app:cardBackgroundColor="@color/xaniteog_surface"
      app:cardCornerRadius="12dp"
      app:cardElevation="2dp"
      app:strokeColor="@color/xaniteog_outline_variant"
      app:strokeWidth="1dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:text="@string/setup_disclaimer_title"
          android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
          android:textColor="@color/xaniteog_notice" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:lineSpacingMultiplier="1.3"
          android:text="@string/setup_disclaimer_body"
          android:textAppearance="@style/TextAppearance.Material3.BodySmall"
          android:textColor="@color/xaniteog_text_muted" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_setup_privacy_policy"
      style="@style/Widget.Material3.Button.TextButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/settings_privacy_policy"
      android:textColor="@color/xaniteog_notice" />

  </LinearLayout>
</androidx.core.widget.NestedScrollView>
