<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#0B0808">

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/xanite_gold_dashboard_background"
    android:scaleType="centerCrop"
    android:alpha="0.25" />

  <View
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#88000000" />

  <!-- ===== SYSTEM LINK (rooms) PANEL ===== -->
  <LinearLayout
    android:id="@+id/panel_system_link"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="visible">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="16dp">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="SYSTEM LINK"
        android:textColor="#C6FF00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

      <LinearLayout
        android:id="@+id/btn_square_plus"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:background="@drawable/xbox_menu_item_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="+\n  □"
          android:textColor="#C6FF00"
          android:textSize="10sp"
          android:textStyle="bold"
          android:gravity="center" />
      </LinearLayout>
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginHorizontal="16dp"
      android:background="@color/xanite_accent_1a" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="16dp"
      android:layout_marginTop="8dp"
      android:text="PLAYERS &amp; ROOMS"
      android:textColor="#C6FF00"
      android:textSize="11sp"
      android:textStyle="bold"
      android:letterSpacing="0.15" />

    <!-- Room list and its status message share this area. Previously an empty
         or non-functional list just left a blank black page, which looked
         identical whether System Link was working with no rooms, switched
         off, or missing its backend entirely. -->
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/room_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp" />

      <TextView
        android:id="@+id/room_list_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingHorizontal="32dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:textColor="#AAFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom hints -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:orientation="horizontal"
      android:paddingHorizontal="16dp"
      android:paddingVertical="8dp">

      <!-- B/Back on the left, A/Refresh on the right, mirrored so the button
           sits on the outer edge - matches the Game Library footer, which had
           the opposite arrangement here. -->
      <LinearLayout
        android:id="@+id/btn_b_back_sl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:background="@drawable/xbox_a_button_bg"
          android:gravity="center"
          android:text="B"
          android:textColor="#000000"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:text="BACK"
          android:textColor="#AAFFFFFF"
          android:textSize="13sp"
          android:textStyle="bold"
          android:letterSpacing="0.15" />
      </LinearLayout>

      <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

      <LinearLayout
        android:id="@+id/btn_a_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="6dp"
          android:text="REFRESH"
          android:textColor="#AAFFFFFF"
          android:textSize="13sp"
          android:textStyle="bold"
          android:letterSpacing="0.15" />

        <TextView
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:background="@drawable/xbox_a_button_bg"
          android:gravity="center"
          android:text="A"
          android:textColor="#000000"
          android:textSize="14sp"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <!-- ===== GAME CATALOG PANEL (Square+) ===== -->
  <LinearLayout
    android:id="@+id/panel_game_catalog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="16dp">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="GAME CATALOG"
        android:textColor="#C6FF00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

      <ImageButton
        android:id="@+id/btn_catalog_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_xaniteog_sync_alt"
        android:scaleType="center"
        android:contentDescription="Close"
        android:rotation="45"
        app:tint="@color/xanite_accent" />
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginHorizontal="16dp"
      android:background="@color/xanite_accent_1a" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="16dp"
      android:layout_marginTop="8dp"
      android:text="SELECT A GAME TO HOST"
      android:textColor="#88FFFFFF"
      android:textSize="11sp"
      android:textStyle="bold"
      android:letterSpacing="0.15" />

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/game_catalog_list"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:paddingHorizontal="12dp"
      android:paddingVertical="8dp" />

    <!-- Bottom hints -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:orientation="horizontal"
      android:paddingHorizontal="16dp"
      android:paddingVertical="8dp">

      <LinearLayout
        android:id="@+id/btn_a_select_game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:background="@drawable/xbox_a_button_bg"
          android:gravity="center"
          android:text="A"
          android:textColor="#000000"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:text="SELECT"
          android:textColor="#AAFFFFFF"
          android:textSize="13sp"
          android:textStyle="bold"
          android:letterSpacing="0.15" />
      </LinearLayout>

      <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

      <LinearLayout
        android:id="@+id/btn_b_back_catalog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:background="@drawable/xbox_a_button_bg"
          android:gravity="center"
          android:text="B"
          android:textColor="#000000"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:text="BACK"
          android:textColor="#AAFFFFFF"
          android:textSize="13sp"
          android:textStyle="bold"
          android:letterSpacing="0.15" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <!-- ===== LOBBY CONFIG PANEL ===== -->
  <LinearLayout
    android:id="@+id/panel_lobby_config"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:visibility="gone">

    <ScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

      <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:cardBackgroundColor="#14120D"
      app:cardCornerRadius="8dp"
      app:cardElevation="0dp"
      app:strokeColor="#33C6FF00"
      app:strokeWidth="1dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="LOBBY SETUP"
          android:textColor="#C6FF00"
          android:textSize="11sp"
          android:textStyle="bold"
          android:letterSpacing="0.2" />

        <TextView
          android:id="@+id/config_game_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="#FFF6EB"
          android:textSize="18sp"
          android:textStyle="bold" />

        <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginVertical="14dp"
          android:background="#1AC6FF00" />

        <!-- Server Name -->
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="SERVER NAME"
          android:textColor="#AAFFFFFF"
          android:textSize="11sp"
          android:textStyle="bold"
          android:letterSpacing="0.1" />

        <EditText
          android:id="@+id/config_server_name"
          android:layout_width="match_parent"
          android:layout_height="44dp"
          android:layout_marginTop="6dp"
          android:background="@drawable/setup_wizard_path_background"
          android:gravity="center_vertical"
          android:paddingHorizontal="12dp"
          android:textColor="#C6FF00"
          android:textColorHint="#44C6FF00"
          android:textSize="14sp"
          android:inputType="text"
          android:maxLines="1" />

        <!-- Public / Private toggle -->
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:text="VISIBILITY"
          android:textColor="#AAFFFFFF"
          android:textSize="11sp"
          android:textStyle="bold"
          android:letterSpacing="0.1" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:orientation="horizontal">

          <com.google.android.material.button.MaterialButton
            android:id="@+id/config_btn_public"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="PUBLIC"
            android:textColor="#C6FF00"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="4dp"
            app:strokeColor="#C6FF00" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/config_btn_private"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="PRIVATE"
            android:textColor="#88FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="4dp"
            app:strokeColor="#44FFFFFF" />
        </LinearLayout>

        <!-- Password (shown when Private) -->
        <LinearLayout
          android:id="@+id/config_password_section"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:orientation="vertical"
          android:visibility="gone">

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASSWORD"
            android:textColor="#AAFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

          <EditText
            android:id="@+id/config_password"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/setup_wizard_path_background"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:textColor="#C6FF00"
            android:textColorHint="#44C6FF00"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:maxLines="1" />
        </LinearLayout>

        <!-- Members count -->
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:text="MAX PLAYERS"
          android:textColor="#AAFFFFFF"
          android:textSize="11sp"
          android:textStyle="bold"
          android:letterSpacing="0.1" />

        <LinearLayout
          android:id="@+id/config_member_buttons"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:orientation="horizontal">

          <com.google.android.material.button.MaterialButton
            android:id="@+id/config_mem_2"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="2"
            android:textColor="#88FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="4dp"
            app:strokeColor="#44FFFFFF" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/config_mem_4"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="4"
            android:textColor="#88FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="4dp"
            app:strokeColor="#44FFFFFF" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/config_mem_8"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="8"
            android:textColor="#C6FF00"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="4dp"
            app:strokeColor="#C6FF00" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/config_mem_16"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="16"
            android:textColor="#88FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="4dp"
            app:strokeColor="#44FFFFFF" />
        </LinearLayout>

        <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginVertical="16dp"
          android:background="#1AC6FF00" />

        <!-- OK / Exit buttons -->
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal">

          <com.google.android.material.button.MaterialButton
            android:id="@+id/config_btn_ok"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="CREATE LOBBY"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#C6FF00"
            app:cornerRadius="4dp" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/config_btn_exit"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="CANCEL"
            android:textColor="#88FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="4dp"
            app:strokeColor="#44FFFFFF" />
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    </ScrollView>
  </LinearLayout>

  <!-- ===== ACTIVE LOBBY PANEL ===== -->
  <LinearLayout
    android:id="@+id/panel_active_lobby"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="16dp">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="IN LOBBY"
        android:textColor="#C6FF00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

      <ImageButton
        android:id="@+id/btn_xbox_live_close2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_xaniteog_sync_alt"
        android:scaleType="center"
        android:contentDescription="Close"
        android:rotation="45"
        app:tint="@color/xanite_accent" />
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginHorizontal="16dp"
      android:background="@color/xanite_accent_1a" />

    <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:padding="16dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Room info card -->
        <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="#14120D"
          app:cardCornerRadius="8dp"
          app:cardElevation="0dp"
          app:strokeColor="#33C6FF00"
          app:strokeWidth="1dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
              android:id="@+id/lobby_title"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="#C6FF00"
              android:textSize="18sp"
              android:textStyle="bold" />

            <TextView
              android:id="@+id/lobby_game"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:textColor="#88FFFFFF"
              android:textSize="13sp" />

            <TextView
              android:id="@+id/lobby_member_count"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:textColor="#AAFFFFFF"
              android:textSize="12sp" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Members card -->
        <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          app:cardBackgroundColor="#14120D"
          app:cardCornerRadius="8dp"
          app:cardElevation="0dp"
          app:strokeColor="#33C6FF00"
          app:strokeWidth="1dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="MEMBERS"
              android:textColor="#C6FF00"
              android:textSize="11sp"
              android:textStyle="bold"
              android:letterSpacing="0.2" />

            <LinearLayout
              android:id="@+id/lobby_members_list"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:orientation="vertical" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>
    </ScrollView>

    <!-- Leave / Ready button -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingHorizontal="16dp"
      android:paddingBottom="8dp"
      android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/lobby_btn_leave"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:text="LEAVE LOBBY"
        android:textColor="#FF4444"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="4dp"
        app:strokeColor="#FF4444" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/lobby_btn_play"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:text="READY"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#C6FF00"
        app:cornerRadius="4dp" />
    </LinearLayout>

    <!-- Bottom hints -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:orientation="horizontal"
      android:paddingHorizontal="16dp"
      android:paddingVertical="8dp">

      <LinearLayout
        android:id="@+id/btn_a_ready"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:background="@drawable/xbox_a_button_bg"
          android:gravity="center"
          android:text="A"
          android:textColor="#000000"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:id="@+id/lbl_ready_hint"
          android:text="READY"
          android:textColor="#AAFFFFFF"
          android:textSize="13sp"
          android:textStyle="bold"
          android:letterSpacing="0.15" />
      </LinearLayout>

      <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

      <LinearLayout
        android:id="@+id/btn_b_back_lobby"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:background="@drawable/xbox_a_button_bg"
          android:gravity="center"
          android:text="B"
          android:textColor="#000000"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:text="LEAVE"
          android:textColor="#AAFFFFFF"
          android:textSize="13sp"
          android:textStyle="bold"
          android:letterSpacing="0.15" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
