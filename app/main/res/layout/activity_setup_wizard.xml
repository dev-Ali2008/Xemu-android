<?xml version="1.0" encoding="utf-8"?>
<!--
  Setup Wizard — 4-step ViewPager2 flow.
  Each page is centered vertically with no scrolling.

  Layout notes:
  - Root is a ConstraintLayout so the top row (progress + orientation
    toggle) and bottom nav bar stay pinned while the pager fills the
    remaining space — this works unchanged in both portrait and
    landscape, since every constraint below is relative to its
    siblings/parent rather than fixed dp positions.
  - SetupWizardActivity declares android:configChanges for
    orientation|screenSize|screenLayout|smallestScreenSize so rotating
    (including via the toggle below) reflows this same layout instead of
    recreating the Activity — the ViewPager2's current step, and every
    picked file/folder shown in each step fragment, survives untouched.
-->
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/setup_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/setup_wizard_background">

  <!-- ── Step indicator bar (4 pills) — narrows to leave room for the
       orientation toggle instead of running full-width. ── -->
  <LinearLayout
    android:id="@+id/setup_step_indicator"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginTop="22dp"
    android:layout_marginEnd="14dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    app:layout_constraintEnd_toStartOf="@id/btn_setup_language"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="@id/btn_setup_language">

    <View
      android:id="@+id/step_dot_1"
      android:layout_width="0dp"
      android:layout_height="6dp"
      android:layout_marginEnd="5dp"
      android:layout_weight="1"
      android:background="@drawable/setup_wizard_indicator_active" />

    <View
      android:id="@+id/step_dot_2"
      android:layout_width="0dp"
      android:layout_height="6dp"
      android:layout_marginEnd="5dp"
      android:layout_weight="1"
      android:background="@drawable/setup_wizard_indicator_inactive" />

    <View
      android:id="@+id/step_dot_3"
      android:layout_width="0dp"
      android:layout_height="6dp"
      android:layout_marginEnd="5dp"
      android:layout_weight="1"
      android:background="@drawable/setup_wizard_indicator_inactive" />

    <View
      android:id="@+id/step_dot_4"
      android:layout_width="0dp"
      android:layout_height="6dp"
      android:layout_weight="1"
      android:background="@drawable/setup_wizard_indicator_inactive" />

  </LinearLayout>

  <!-- ── Language button — opens a dialog to pick UI language ── -->
  <com.google.android.material.button.MaterialButton
    android:id="@+id/btn_setup_language"
    style="@style/Widget.Xaniteog.TabButton"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_marginEnd="8dp"
    android:gravity="center"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:text="A"
    android:textColor="@color/xanite_accent"
    android:textSize="16sp"
    android:textStyle="bold"
    app:iconPadding="0dp"
    app:layout_constraintBottom_toBottomOf="@id/setup_orientation_toggle"
    app:layout_constraintEnd_toStartOf="@id/setup_orientation_toggle"
    app:layout_constraintTop_toTopOf="@id/setup_orientation_toggle" />

  <!-- ── Orientation toggle — top-right corner, compact icon-only
       segmented control. Selecting a side immediately applies that
       orientation and persists it via OrientationPreferences, without
       recreating the Activity (see configChanges note above). ── -->
  <com.google.android.material.button.MaterialButtonToggleGroup
    android:id="@+id/setup_orientation_toggle"
    style="@style/Widget.Xaniteog.OrientationToggleGroup"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginTop="16dp"
    android:layout_marginEnd="20dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:selectionRequired="true"
    app:singleSelection="true">

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_orientation_vertical"
      style="@style/Widget.Xaniteog.OrientationButton"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:contentDescription="@string/setup_orientation_vertical"
      android:gravity="center"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      android:paddingStart="0dp"
      android:paddingEnd="0dp"
      app:icon="@drawable/ic_orientation_portrait"
      app:iconGravity="textStart"
      app:iconPadding="0dp"
      app:iconSize="20dp" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_orientation_horizontal"
      style="@style/Widget.Xaniteog.OrientationButton"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:contentDescription="@string/setup_orientation_horizontal"
      android:gravity="center"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      android:paddingStart="0dp"
      android:paddingEnd="0dp"
      app:icon="@drawable/ic_orientation_landscape"
      app:iconGravity="textStart"
      app:iconPadding="0dp"
      app:iconSize="20dp" />

  </com.google.android.material.button.MaterialButtonToggleGroup>

  <!-- ── ViewPager2 — swipe disabled, controlled by buttons ── -->
  <androidx.viewpager2.widget.ViewPager2
    android:id="@+id/setup_pager"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginTop="16dp"
    app:layout_constraintBottom_toTopOf="@id/setup_nav_bar"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/setup_orientation_toggle" />

  <!-- ── Bottom nav bar: Back + Continue, lifted onto its own subtly
       elevated strip so it reads as a persistent action bar rather
       than floating in empty space. ── -->
  <View
    android:id="@+id/setup_nav_divider"
    android:layout_width="0dp"
    android:layout_height="1dp"
    android:background="@color/xaniteog_outline_variant"
    app:layout_constraintBottom_toTopOf="@id/setup_nav_bar"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent" />

  <LinearLayout
    android:id="@+id/setup_nav_bar"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="18dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">

    <!-- Back button — hidden on step 1 -->
    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_setup_back"
      style="@style/Widget.Xaniteog.Button.Outlined"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/setup_back"
      android:visibility="gone" />

    <View
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1" />

    <!-- Continue / Finish -->
    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_setup_continue"
      style="@style/Widget.Xaniteog.Button"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/setup_hub_continue"
      app:icon="@drawable/ic_xaniteog_play"
      app:iconGravity="textEnd"
      app:iconPadding="8dp" />

  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
