<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/tab_content_joystick"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <!-- JOYSTICK -->
  <com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1A170D"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/xanite_accent_33"
    app:strokeWidth="1dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:letterSpacing="0.12"
        android:text="JOYSTICK"
        android:textColor="@color/xanite_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Enable Joystick"
          android:textColor="#FFF6EB"
          android:textSize="14sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
          android:id="@+id/switch_joystick_enabled"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/xanite_accent_1a" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Invert X Axis"
          android:textColor="#FFF6EB"
          android:textSize="14sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
          android:id="@+id/switch_joystick_invert_x"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/xanite_accent_1a" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Invert Y Axis"
          android:textColor="#FFF6EB"
          android:textSize="14sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
          android:id="@+id/switch_joystick_invert_y"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/xanite_accent_1a" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Deadzone"
        android:textColor="#FFF6EB"
        android:textSize="14sp" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SeekBar
          android:id="@+id/seek_joystick_deadzone"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:max="330"
          android:progress="100" />

        <TextView
          android:id="@+id/tv_joystick_deadzone_value"
          android:layout_width="48dp"
          android:layout_height="wrap_content"
          android:gravity="end"
          android:text="0.12"
          android:textColor="@color/xanite_accent"
          android:textSize="13sp"
          android:textStyle="bold" />
      </LinearLayout>

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/xanite_accent_1a" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sensitivity"
        android:textColor="#FFF6EB"
        android:textSize="14sp" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SeekBar
          android:id="@+id/seek_joystick_sensitivity"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:max="200"
          android:progress="100" />

        <TextView
          android:id="@+id/tv_joystick_sensitivity_value"
          android:layout_width="40dp"
          android:layout_height="wrap_content"
          android:gravity="end"
          android:text="1.0"
          android:textColor="@color/xanite_accent"
          android:textSize="13sp"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</LinearLayout>
