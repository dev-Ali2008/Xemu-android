<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/tab_content_rendering"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <!-- TEXTURE QUALITY -->
  <com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1A170D"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/xanite_accent_33"
    app:strokeWidth="1dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:letterSpacing="0.12"
        android:text="@string/settings_texture_quality"
        android:textColor="@color/xanite_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

      <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_texture_quality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_tex_lowend"
        style="?attr/materialButtonOutlinedStyle"
        app:backgroundTint="@color/settings_toggle_btn_bg"
        app:strokeColor="@color/xanite_accent"
        app:strokeWidth="1dp"
        android:layout_width="0dp"
          android:layout_height="44dp"
          android:layout_weight="1"
          android:text="@string/settings_texture_quality_lowend"
          android:textColor="@color/settings_toggle_btn_text"
          android:textSize="11sp"
          android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_tex_low"
        style="?attr/materialButtonOutlinedStyle"
        app:backgroundTint="@color/settings_toggle_btn_bg"
        app:strokeColor="@color/xanite_accent"
        app:strokeWidth="1dp"
        android:layout_width="0dp"
          android:layout_height="44dp"
          android:layout_weight="1"
          android:text="@string/settings_texture_quality_low"
          android:textColor="@color/settings_toggle_btn_text"
          android:textSize="11sp"
          android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_tex_normal"
        style="?attr/materialButtonOutlinedStyle"
        app:backgroundTint="@color/settings_toggle_btn_bg"
        app:strokeColor="@color/xanite_accent"
        app:strokeWidth="1dp"
        android:layout_width="0dp"
          android:layout_height="44dp"
          android:layout_weight="1"
          android:text="@string/settings_texture_quality_normal"
          android:textColor="@color/settings_toggle_btn_text"
          android:textSize="11sp"
          android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_tex_high"
        style="?attr/materialButtonOutlinedStyle"
        app:backgroundTint="@color/settings_toggle_btn_bg"
        app:strokeColor="@color/xanite_accent"
        app:strokeWidth="1dp"
        android:layout_width="0dp"
          android:layout_height="44dp"
          android:layout_weight="1"
          android:text="@string/settings_texture_quality_high"
          android:textColor="@color/settings_toggle_btn_text"
          android:textSize="11sp"
          android:textStyle="bold" />
      </com.google.android.material.button.MaterialButtonToggleGroup>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_texture_quality_hint"
        android:textColor="#BFA898"
        android:textSize="12sp" />
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>

  <!-- RENDERING OPTIONS -->
  <com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1A170D"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/xanite_accent_33"
    app:strokeWidth="1dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:letterSpacing="0.12"
        android:text="RENDERING"
        android:textColor="@color/xanite_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true" />

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_cache_shaders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_cache_shaders"
        android:textColor="#FFF6EB"
        android:textSize="14sp" />

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_skip_boot_anim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/settings_skip_boot_anim"
        android:textColor="#FFF6EB"
        android:textSize="14sp" />

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_draw_reorder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/settings_draw_reorder"
        android:textColor="#FFF6EB"
        android:textSize="14sp" />

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_draw_merge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/settings_draw_merge"
        android:textColor="#FFF6EB"
        android:textSize="14sp" />

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_async_compile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/settings_async_compile"
        android:textColor="#FFF6EB"
        android:textSize="14sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="52dp"
        android:text="@string/settings_async_compile_hint"
        android:textColor="#BFA898"
        android:textSize="12sp" />
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>

</LinearLayout>
