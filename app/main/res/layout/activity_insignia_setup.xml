<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#0B0808">

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop"
    android:alpha="0.25"
    android:contentDescription="@null"
    android:src="@drawable/xanite_gold_dashboard_background" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- HEADER: back on the left, matching Settings -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="16dp">

      <ImageButton
        android:id="@+id/btn_insignia_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_back"
        android:scaleType="center"
        android:contentDescription="@string/settings_back"
        app:tint="@color/xanite_accent" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/insignia_title"
          android:textColor="@color/xanite_accent"
          android:textSize="18sp"
          android:textStyle="bold"
          android:letterSpacing="0.08" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/insignia_subtitle"
          android:textColor="#AAFFFFFF"
          android:textSize="11sp"
          android:letterSpacing="0.1" />
      </LinearLayout>
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginHorizontal="16dp"
      android:background="@color/xanite_accent_33" />

    <ScrollView
      android:id="@+id/insignia_scroll"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true"
      android:scrollbars="none">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- ===== ALL SET ===== -->
        <LinearLayout
          android:id="@+id/insignia_done_panel"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:background="@drawable/xbox_menu_item_bg"
          android:padding="20dp"
          android:visibility="gone">

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/insignia_all_set_heading"
            android:textColor="@color/xanite_accent"
            android:textSize="20sp"
            android:textStyle="bold" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/insignia_all_set_body"
            android:textColor="#DDFFF6EB"
            android:textSize="14sp" />

          <TextView
            android:id="@+id/insignia_gamertag_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/xanite_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

          <Button
            android:id="@+id/btn_insignia_redo"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/insignia_redo" />
        </LinearLayout>

        <!-- ===== SETUP ===== -->
        <LinearLayout
          android:id="@+id/insignia_setup_panel"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/insignia_welcome_heading"
            android:textColor="@color/xanite_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/insignia_welcome_body"
            android:textColor="#DDFFF6EB"
            android:textSize="14sp" />

          <LinearLayout
            android:id="@+id/insignia_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />

          <Button
            android:id="@+id/btn_insignia_guide"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/insignia_guide_action" />

          <Button
            android:id="@+id/btn_insignia_clear"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/insignia_clear_action"
            android:textColor="#FF8A80"
            app:strokeColor="#66FF8A80" />
        </LinearLayout>

      </LinearLayout>
    </ScrollView>
  </LinearLayout>
</FrameLayout>
