<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipToPadding="false"
  android:fillViewport="true"
  android:paddingHorizontal="24dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="24dp">

    <ImageView
      android:layout_width="56dp"
      android:layout_height="56dp"
      android:contentDescription="@string/settings_gpu_driver_title"
      android:src="@drawable/ic_xaniteog_sync_alt"
      app:tint="@color/xaniteog_green" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/setup_driver_step_title"
      android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
      android:textColor="@color/xaniteog_text"
      android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      app:cardBackgroundColor="@color/xaniteog_surface_variant"
      app:cardCornerRadius="16dp"
      app:cardElevation="6dp"
      app:strokeColor="@color/xaniteog_outline_variant"
      app:strokeWidth="1.5dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:lineSpacingMultiplier="1.4"
        android:text="@string/setup_driver_step_body"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/xaniteog_text_muted" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      app:cardBackgroundColor="@color/xaniteog_surface_variant"
      app:cardCornerRadius="18dp"
      app:cardElevation="6dp"
      app:strokeColor="@color/xaniteog_outline_variant"
      app:strokeWidth="1.5dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
          android:id="@+id/tv_active_driver"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/setup_wizard_path_background"
          android:text="@string/settings_gpu_driver_system"
          android:textAppearance="@style/TextAppearance.Material3.BodySmall"
          android:textColor="@color/xaniteog_text_muted" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_install_driver"
          style="@style/Widget.Xaniteog.Button.Outlined.Pill"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="@string/settings_gpu_driver_install"
          app:icon="@drawable/ic_xaniteog_upload_file"
          app:iconGravity="textStart"
          app:iconPadding="8dp" />

      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:gravity="center"
      android:text="@string/setup_driver_settings_hint"
      android:textAppearance="@style/TextAppearance.Material3.BodySmall"
      android:textColor="@color/xaniteog_text_muted" />

  </LinearLayout>
</androidx.core.widget.NestedScrollView>
