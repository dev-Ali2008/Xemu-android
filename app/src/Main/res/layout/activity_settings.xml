<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_xbox">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/xemu_surface"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/xemu_outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Title -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:text="@string/settings_title"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />

                    <!-- ==================== DISPLAY SECTION ==================== -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/settings_section_display"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/xemu_green"
                        android:textSize="18sp" />

                    <!-- Renderer -->
                    <TextView
                        android:id="@+id/tv_renderer_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_graphics_api"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_renderer_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="OpenGL"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Texture Filtering -->
                    <TextView
                        android:id="@+id/tv_filtering_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_filtering"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_filtering_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Linear"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Internal Resolution Scale -->
                    <TextView
                        android:id="@+id/tv_resolution_scale_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_resolution_scale"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_resolution_scale_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="1x (Native)"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Display Mode -->
                    <TextView
                        android:id="@+id/tv_display_mode_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_display_mode"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_display_mode_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Stretch"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Frame Rate Limit -->
                    <TextView
                        android:id="@+id/tv_frame_rate_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_frame_rate_limit"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_frame_rate_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="60 FPS"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- System Memory -->
                    <TextView
                        android:id="@+id/tv_system_memory_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_system_memory"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_system_memory_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="64 MB"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- System Memory Hint -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:text="@string/settings_system_memory_hint"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="14sp" />

                    <!-- ==================== VULKAN DRIVER SECTION ==================== -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/settings_section_vulkan_driver"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/xemu_green"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_vulkan_driver_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/settings_vulkan_driver_none"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_vulkan_browse"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="@string/settings_vulkan_driver_browse" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_vulkan_clear"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="@string/settings_vulkan_driver_clear" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:text="@string/settings_vulkan_driver_hint"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="14sp" />

                    <!-- ==================== PERFORMANCE SECTION ==================== -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/settings_section_performance"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/xemu_green"
                        android:textSize="18sp" />

                    <!-- TCG Thread -->
                    <TextView
                        android:id="@+id/tv_tcg_thread_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_tcg_thread"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_tcg_thread_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Multi-threaded"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Audio Driver -->
                    <TextView
                        android:id="@+id/tv_audio_driver_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_audio_driver"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_audio_driver_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="OpenSL ES"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- ==================== SWITCHES ==================== -->
                    <!-- All switches at the bottom -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_vsync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_vsync"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_hard_fpu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_hard_fpu"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_cache_shaders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_cache_shaders"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_skip_boot_anim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_skip_boot_anim"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_use_dsp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_use_dsp"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_hrtf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/settings_hrtf"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp" />

                    <!-- ==================== EEPROM SETTINGS ==================== -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/settings_section_eeprom"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/xemu_green"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_eeprom_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="14sp" />

                    <!-- EEPROM Language -->
                    <TextView
                        android:id="@+id/tv_eeprom_language_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_eeprom_language"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_eeprom_language_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="English"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- EEPROM Video Standard -->
                    <TextView
                        android:id="@+id/tv_eeprom_video_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_eeprom_video_standard"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_eeprom_video_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="NTSC-M"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- EEPROM Refresh Rate -->
                    <TextView
                        android:id="@+id/tv_eeprom_refresh_rate_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_eeprom_refresh_rate"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_eeprom_refresh_rate_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Auto"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- EEPROM Aspect Ratio -->
                    <TextView
                        android:id="@+id/tv_eeprom_aspect_ratio_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_eeprom_aspect_ratio"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_eeprom_aspect_ratio_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Auto"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- EEPROM Resolution -->
                    <TextView
                        android:id="@+id/tv_eeprom_resolution_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_eeprom_resolution"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_eeprom_resolution_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Auto"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- EEPROM Hint -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"
                        android:text="@string/settings_eeprom_hint"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/xemu_text_muted"
                        android:textSize="14sp" />

                    <!-- Save button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_settings_save"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/settings_save" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_redo_setup_wizard"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_redo_setup_wizard" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>