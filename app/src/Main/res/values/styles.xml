<resources>
    
    <style name="Theme.Black.NoTitleBar.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fontFamily">@font/xbox_regular</item>
        <item name="android:windowEnterAnimation">@anim/shader_fade_in</item>
        <item name="android:windowExitAnimation">@anim/shader_fade_out</item>
    </style>
</resources>